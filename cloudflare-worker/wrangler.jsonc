{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "job-searcher-live-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "JOB_STATE",
        "class_name": "JobState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "JobState"
      ]
    }
  ]
}
