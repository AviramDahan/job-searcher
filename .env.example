TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DEFAULT_TIMEZONE=Asia/Jerusalem

# Optional local paths. Keep real CV files outside Git.
CV_PATH=
JOB_APPLICATIONS_CSV=outputs/job_applications.csv
JOB_SEARCH_SUMMARY=outputs/job_search_summary.md
CANDIDATE_PROFILE_PATH=data/private/candidate_profile.local.json

# JobMaster browser submission adapter. Keep real values in .env only.
JOBMASTER_EMAIL=
JOBMASTER_PASSWORD=
JOBMASTER_EXPECTED_CV_FILENAME=
JOBMASTER_HEADLESS=true

# Optional overrides. Prefer the private JSON file for real candidate data.
CANDIDATE_FULL_NAME=
CANDIDATE_NATIONAL_ID=
CANDIDATE_HAS_RELATIVES_AT_COMPANY=
CANDIDATE_HAS_DRIVING_LICENSE=
CANDIDATE_HAS_CAR=
CANDIDATE_CAN_ARRIVE_INDEPENDENTLY=
CANDIDATE_MARKETING_CONSENT_APPROVED=
CANDIDATE_APPROVED_SALARY_EXPECTATION=
